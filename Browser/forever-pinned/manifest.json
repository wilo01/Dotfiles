{
  "manifest_version": 3,
  "name": "Forever Pinned",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "description": "Allows you to open a set of pinned tabs when Chrome starts up",
  "version": "0.30",
  "action": {
    "default_title": "Click to restore Pinned Tabs!"
  }
}