#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/ ~/Dev ~/.Dotfiles/ ~/tds-hexer/ ~/tds-branch-opener/branches/tds-suite/ ~/Dev/branch-opener/branches/ ~/Dev/branch-opener2/branches/ ~/.config/Prime/ ~/Dev/branch-opener/branches/safe/source/server/rt/ ~/Dev/branch-opener/branches/safe/source/server/rtkiosk/ ~/Dev/branch-opener/branches/safe/source/ ~/Dev/branch-opener/branches/safe/source/ui/ ~/Dev/branch-opener/branches/safe/source/ui-kiosk/ ~/Dev/branch-opener2/branches/safe/source/ ~/Dev/branch-opener/branches/virtual-receptionist/ ~/Dev/branch-opener/branches/virtual-receptionist/frontendv3/ ~/Dev/branch-opener/branches/virtual-receptionist/frontendv3/demos/browser/app/meetingV2/ ~/Dev/TDS/developers-at-home-sg/ ~/Dev/branch-opener/branches/safe/test/Cypress/ ~/Dev/DarO/note-app/ -mindepth 0 -maxdepth 2 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
selected=$(realpath "$selected")

get_unique_session_name() {
    local base_name=$1
    local target_path=$2
    local name=$base_name
    local counter=2

    while tmux has-session -t="$name" 2>/dev/null; do
        existing_path=$(tmux display-message -t "$name" -p '#{session_path}')
        if [[ "$existing_path" == "$target_path" ]]; then
            echo "$name"
            return
        fi
        name="${base_name}-${counter}"
        ((counter++))
    done
    echo "$name"
}

session_name=$(get_unique_session_name "$selected_name" "$selected")
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$session_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$session_name" 2> /dev/null; then
    tmux new-session -ds "$session_name" -c "$selected"
fi

tmux switch-client -t "$session_name"
