{
  "permissions": {
    "allow": [
      "Bash(stow:*)",
      "Bash(task-master:*)",
      "Bash(git:*)",
      "Bash(npm run:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(cat:*)",
      "Bash(tree:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)"
    ],
    "allowedTools": [
      "Edit",
      "MultiEdit", 
      "Read",
      "Write",
      "Bash",
      "Glob",
      "Grep",
      "LS",
      "TodoWrite",
      "Task",
      "ExitPlanMode",
      "NotebookRead",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__task_master_ai__*"
    ],
    "deniedTools": [
      "Bash(rm *)",
      "Bash(rm -*)",
      "Bash(*rm *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": {},
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/master-hook.sh"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "task-master-ai"
  ],
  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30
}