#!/bin/bash

enable_local_hooks=$(git config --local hooks.enableLocalHooks)
PROJECT_ROOT=$(git rev-parse --show-toplevel)
if [ "$enable_local_hooks" == true ] && [ -e "$PROJECT_ROOT/.githooks/pre-commit" ]; then
   echo "Run local pre-commit hook"
   "$PROJECT_ROOT/.githooks/pre-commit" "$@"

   exit_status=$?
   if [ $exit_status -ne 0 ]; then
      echo "Local pre-commit hook failed with exit code $exit_status"
      exit $exit_status
   fi
   echo "End of local pre-commit hook"
fi

enable_global_hooks=$(git config --local hooks.enableGlobalHooks)
if [ "$enable_global_hooks" != true ]; then
   echo "Global git prepare-commit-msg is disabled via Git config."
   exit 0
fi

echo "Global git prepare-commit-msg run"
branchFullName=$(git symbolic-ref --short HEAD)
jiraTag=$(git symbolic-ref --short HEAD | cut -d'-' -f1,2)

firstLine=$(head -n1 "$1")

if [ -z "$firstLine" ]; then
   enable_ai_commit=$(git config --local hooks.enableAiCommit)

   if [ "$enable_ai_commit" == "true" ]; then
      echo "Generating AI commit message..."

      diff_stat=$(git diff --staged --stat 2>/dev/null)
      diff_names=$(git diff --staged --name-status 2>/dev/null)

      diff_content=$(git diff --staged --unified=1 2>/dev/null | head -200)

      files_changed=$(echo "$diff_names" | wc -l)
      lines_added=$(git diff --staged --numstat 2>/dev/null | awk '{sum+=$1} END {print sum}')
      lines_deleted=$(git diff --staged --numstat 2>/dev/null | awk '{sum+=$2} END {print sum}')

      if [ "$files_changed" -gt 50 ] || [ "$lines_added" -gt 2000 ]; then
         echo "Large changeset detected ($files_changed files, +$lines_added/-$lines_deleted lines), using structured analysis"

         change_summary=$(git diff --staged --name-status | grep -vE '\.(lock|log|tmp|cache|min\.js|min\.css|bundle\.js)$|/(dist|build|node_modules|\.git|\.cache|logs?)/' | awk '
            BEGIN {
               new_count=0; mod_count=0; del_count=0
               dirs[""]=0; types[""]=0
            }
            /^A/ { new_files[++new_count]=$2; dirs[gensub(/\/[^\/]*$/, "", 1, $2)]++; types[gensub(/.*\./, "", 1, $2)]++ }
            /^M/ { mod_files[++mod_count]=$2; dirs[gensub(/\/[^\/]*$/, "", 1, $2)]++; types[gensub(/.*\./, "", 1, $2)]++ }
            /^D/ { del_files[++del_count]=$2; dirs[gensub(/\/[^\/]*$/, "", 1, $2)]++; types[gensub(/.*\./, "", 1, $2)]++ }
            /^R/ {
               split($0, parts, /\t/)
               ren_files[++ren_count]=parts[2] " -> " parts[3]
               dirs[gensub(/\/[^\/]*$/, "", 1, parts[3])]++
               types[gensub(/.*\./, "", 1, parts[3])]++
            }
            END {
               print "SUMMARY: " new_count " new, " mod_count " modified, " del_count " deleted, " ren_count " renamed files"
               print "DIRECTORIES:"
               for (d in dirs) if (d != "" && dirs[d] > 0) print "  " d ": " dirs[d] " files"
               print "FILE_TYPES:"
               for (t in types) if (t != "" && types[t] > 0) print "  ." t ": " types[t] " files"
               print "KEY_CHANGES:"
               for (i=1; i<=new_count && i<=5; i++) print "  NEW: " new_files[i]
               for (i=1; i<=mod_count && i<=5; i++) print "  MOD: " mod_files[i]
               for (i=1; i<=del_count && i<=3; i++) print "  DEL: " del_files[i]
               for (i=1; i<=ren_count && i<=3; i++) print "  REN: " ren_files[i]
            }
         ')

         ai_prompt="Generate commit bullet points for this large changeset:

$change_summary

Total: $files_changed files, +$lines_added/-$lines_deleted lines

Based on the structured change summary above, generate bullet points that:
- Summarize the main areas of change (by directory/component)
- Highlight key new features or files added
- Note major modifications or refactoring
- Mention important deletions or renames

IMPORTANT: Keep each bullet point under 72 characters. Focus on high-level changes.
Output ONLY bullet points starting with '- '. Be concise but informative."
      else
         ai_prompt="Analyze these git changes and generate commit message bullet points.

Summary: $files_changed files changed, +$lines_added lines added, -$lines_deleted lines deleted

Files changed:
$diff_names

Diff statistics:
$diff_stat

Actual diff content (showing what was changed):
$diff_content

Based on the actual diff above, generate bullet points describing what was ACTUALLY changed. Use as many points as needed to cover all significant changes.
Focus on:
- What functionality was added/modified/removed
- What configuration or settings were changed
- What bugs were fixed or features implemented
- The actual code changes, not just file names

IMPORTANT: Keep each bullet point under 72 characters. Break long changes into multiple shorter points.
Output ONLY bullet points starting with '- '. Be specific and technical about the actual changes."
      fi

      echo "Calling Claude AI (this may take a moment)..."
      claude_response=$(echo "$ai_prompt" | timeout 30 /usr/local/bin/claude -p 2>/dev/null || true)
      log_points=$(echo "$claude_response" | grep "^- " || true)

      if [ -n "$log_points" ]; then
         echo "Claude generated commit points successfully"
      else
         echo "Claude response didn't contain bullet points, trying Gemini..."
         gemini_response=$(timeout 30 /usr/local/bin/gemini -p "$ai_prompt" 2>/dev/null || true)
         log_points=$(echo "$gemini_response" | grep "^- " || true)

         if [ -n "$log_points" ]; then
            echo "Gemini generated commit points successfully"
         else
            echo "AI responses didn't contain proper bullet points, using fallback template"
            log_points=""
         fi
      fi

      if [ -n "$log_points" ]; then
         echo "AI-generated commit points ready"
         {
            echo "$jiraTag"
            echo ""
            echo "$branchFullName"
            echo ""
            echo "Logs:"
            echo "$log_points"
         } > "$1"
      else
         echo "AI generation failed, using default template"
         {
            echo "$jiraTag"
            echo ""
            echo "$branchFullName"
            echo ""
            echo "Logs:"
            echo "- "
         } > "$1"
      fi
   else
      {
         echo "$jiraTag"
         echo ""
         echo "$branchFullName"
         echo ""
         echo "Logs:"
         echo "- "
      } > "$1"
   fi
else
   :
fi
