#!/bin/bash

enable_local_hooks=$(git config --local hooks.enableLocalHooks)
PROJECT_ROOT=$(git rev-parse --show-toplevel)
if [ "$enable_local_hooks" == true ] && [ -e "$PROJECT_ROOT/.githooks/pre-commit" ]; then
   echo "Run local pre-commit hook"
   "$PROJECT_ROOT/.githooks/pre-commit" "$@"

   # Catch the exit code of the pre-commit hook
   exit_status=$?
   if [ $exit_status -ne 0 ]; then
      echo "Local pre-commit hook failed with exit code $exit_status"
      exit $exit_status
   fi
   echo "End of local pre-commit hook"
fi

enable_global_hooks=$(git config --local hooks.enableGlobalHooks)
if [ "$enable_global_hooks" != true ]; then
   echo "Global git prepare-commit-msg is disabled via Git config."
   exit 0
fi

echo "Global git prepare-commit-msg run"
branchFullName=$(git symbolic-ref --short HEAD)
jiraTag=$(git symbolic-ref --short HEAD | cut -d'-' -f1,2)

firstLine=$(head -n1 "$1")

if [ -z "$firstLine" ]; then
   # Check if AI commit generation is enabled
   enable_ai_commit=$(git config --local hooks.enableAiCommit)

   if [ "$enable_ai_commit" == "true" ]; then
      echo "Generating AI commit message..."

      # Get the diff information  
      diff_stat=$(git diff --staged --stat 2>/dev/null)
      diff_names=$(git diff --staged --name-status 2>/dev/null)
      # Get actual diff content (first 100 lines to avoid huge prompts)
      diff_content=$(git diff --staged --unified=3 2>/dev/null | head -100)

      # Create a comprehensive prompt for AI
      ai_prompt="Analyze these git changes and generate commit message bullet points.

Files changed:
$diff_names

Diff statistics:
$diff_stat

Actual changes (truncated):
$diff_content

Generate 2-5 concise bullet points describing what was actually changed.
Output ONLY bullet points starting with '- '. Be specific about the changes, not just file names."

      # Try Claude first (with 15 second timeout and better error handling)
      # Debug: Save prompt for troubleshooting
      # echo "$ai_prompt" > /tmp/git-ai-prompt.txt
      log_points=$(echo "$ai_prompt" | timeout 15 /usr/local/bin/claude --print 2>&1 | grep "^- " | head -5)

      # If Claude fails or returns empty, try Gemini
      if [ -z "$log_points" ]; then
         echo "Claude failed, trying Gemini..."
         # Gemini needs the prompt as an argument, not stdin
         log_points=$(timeout 15 /usr/local/bin/gemini -p "$ai_prompt" 2>/dev/null | grep "^- " | head -5)
      fi

      # Use AI-generated points if we got them
      if [ -n "$log_points" ]; then
         echo "AI-generated commit points ready"
         # Format the commit message with AI-generated points
         {
            echo "$jiraTag"
            echo ""
            echo "$branchFullName"
            echo ""
            echo "Logs:"
            echo "$log_points"
         } > "$1"
      else
         # Fallback to original behavior if both AIs fail
         echo "AI generation failed, using default template"
         sed -i.bak "1s/^/$jiraTag\n\n$branchFullName\n\nLogs:\n- /" "$1"
      fi
   else
      # Original behavior when AI commit is disabled
      sed -i.bak "1s/^/$jiraTag\n\n$branchFullName\n\nLogs:\n- /" "$1"
   fi
else
   # If there's already content, don't modify
   :
fi
