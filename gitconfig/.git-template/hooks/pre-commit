#!/bin/bash
# Git pre-commit hook - Credential detection with interactive prompt
#
# This hook scans staged files for potential credentials and secrets.
# When detected, prompts user to proceed or abort.
#
# Configuration (git config):
#   hooks.enableCredentialScan false  # Disable scanning entirely
#   hooks.useGitleaks false           # Disable gitleaks (use custom patterns only)
#   hooks.credentialPrompt false      # Disable prompt (warning only)
#
# Environment Variables:
#   SKIP_CREDENTIAL_CHECK=1   # Skip credential check (other hooks still run)
#   GIT_CREDENTIAL_STRICT=1   # Block commits with findings even without TTY
#
# Usage:
#   git commit                           # Normal - prompts if findings
#   SKIP_CREDENTIAL_CHECK=1 git commit   # Skip credential check only
#   git commit --no-verify               # Skip ALL hooks

# Source common functions
HOOKS_DIR=$(dirname "$0")
# shellcheck source=hooks-common.sh
source "${HOOKS_DIR}/hooks-common.sh" || {
    echo "Failed to load hooks-common.sh" >&2
    exit 0  # Don't block commit if common lib fails
}

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

load_hook_config

# Check if global hooks are enabled
if [[ "$ENABLE_GLOBAL_HOOKS" != "true" ]]; then
    exit 0
fi

# -----------------------------------------------------------------------------
# Local Hook Integration
# -----------------------------------------------------------------------------

run_local_pre_commit_hooks() {
    if [[ "$ENABLE_LOCAL_HOOKS" == "true" ]]; then
        local project_root
        project_root=$(get_project_root)
        local local_hook="${project_root}/.githooks/pre-commit"

        if [[ -x "$local_hook" ]]; then
            log_info "Running local pre-commit hook"
            "$local_hook"
            local exit_status=$?

            if [[ $exit_status -ne 0 ]]; then
                log_error "Local pre-commit hook failed with exit code $exit_status"
                return $exit_status
            fi
            log_success "Local pre-commit hook completed"
        fi
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Interactive Prompt
# -----------------------------------------------------------------------------

prompt_user_for_credentials() {
    local enable_prompt
    enable_prompt=$(git config --local hooks.credentialPrompt 2>/dev/null || echo "true")

    if [[ "$enable_prompt" != "true" ]]; then
        # Prompt disabled - just warn and continue
        echo "Proceeding with commit (prompt disabled)..." >&2
        return 0
    fi

    # Check if we have a TTY for interactive input
    if [[ ! -t 0 ]]; then
        echo "" >&2
        # Check if strict mode is enabled (block on no-TTY)
        if [[ "${GIT_CREDENTIAL_STRICT:-}" == "1" ]]; then
            echo "No TTY available and GIT_CREDENTIAL_STRICT=1 is set." >&2
            echo "Aborting commit. Use SKIP_CREDENTIAL_CHECK=1 to bypass." >&2
            return 1
        fi
        # Default: allow commit with warning (notify-only mode)
        echo "Proceeding with commit (no TTY - notification only)." >&2
        echo "To block commits with findings, set: GIT_CREDENTIAL_STRICT=1" >&2
        return 0
    fi

    echo "" >&2
    echo "Do you want to proceed with the commit? [y/N/s]" >&2
    echo "  y = Yes, proceed anyway" >&2
    echo "  N = No, abort commit (default)" >&2
    echo "  s = Skip future checks for this repo" >&2
    echo "" >&2

    # Read from terminal directly
    read -r -n 1 -p "Your choice: " choice </dev/tty
    echo "" >&2

    case "${choice,,}" in
        y)
            echo "Proceeding with commit..." >&2
            return 0
            ;;
        s)
            echo "Disabling credential scan for this repository..." >&2
            git config --local hooks.enableCredentialScan false
            echo "Re-enabled with: git config hooks.enableCredentialScan true" >&2
            return 0
            ;;
        *)
            echo "Commit aborted." >&2
            return 1
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
    # Run local hooks first (if enabled)
    run_local_pre_commit_hooks || exit $?

    # Check if credential check should be skipped via environment variable
    if [[ "${SKIP_CREDENTIAL_CHECK:-}" == "1" ]]; then
        log_info "Credential check skipped (SKIP_CREDENTIAL_CHECK=1)"
        exit 0
    fi

    # Run credential scan
    if ! run_credential_scan; then
        # Credentials detected - prompt user
        if ! prompt_user_for_credentials; then
            exit 1
        fi
    fi

    exit 0
}

main "$@"
