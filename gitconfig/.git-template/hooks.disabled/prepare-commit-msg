#!/bin/bash
# Git prepare-commit-msg hook - AI-powered commit message generation

# Source common functions
HOOKS_DIR=$(dirname "$0")
source "${HOOKS_DIR}/hooks-common.sh" || {
   echo "❌ Failed to load hooks-common.sh" >&2
   exit 1
}

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

load_hook_config
debug_config

# -----------------------------------------------------------------------------
# Local Hook Integration
# -----------------------------------------------------------------------------

run_local_hooks() {
   if [[ "$ENABLE_LOCAL_HOOKS" == "true" ]]; then
      local project_root=$(get_project_root)
      local local_hook="${project_root}/.githooks/prepare-commit-msg"

      if [[ -x "$local_hook" ]]; then
         log_info "🔄 Running local prepare-commit-msg hook"
         "$local_hook" "$@"
         local exit_status=$?

         if [[ $exit_status -ne 0 ]]; then
            log_error "Local prepare-commit-msg hook failed with exit code $exit_status"
            return $exit_status
         fi
         log_success "Local prepare-commit-msg hook completed"
      fi
   fi
   return 0
}

# -----------------------------------------------------------------------------
# Commit Message Writing
# -----------------------------------------------------------------------------

# Write commit message with consistent format and error handling
write_commit_message() {
   local jira_tag="$1"
   local branch_name="$2"
   local log_content="$3"
   local commit_msg_file="$4"

   {
      echo "$jira_tag"
      echo ""
      echo "$branch_name"
      echo ""
      echo "Logs:"
      echo "$log_content"
   } >"$commit_msg_file" || {
      log_error "Failed to write commit message to $commit_msg_file"
      return 1
   }
}

# -----------------------------------------------------------------------------
# AI Prompt Generation
# -----------------------------------------------------------------------------

generate_ai_prompt() {
   local diff_content="$1"
   local files_changed="$2"
   local lines_added="$3"
   local lines_deleted="$4"

   local prompt=""

   if ((files_changed > 50 || lines_added > 2000)); then
      log_info "📊 Large changeset detected ($files_changed files, +$lines_added/-$lines_deleted lines)"

      # Generate structured summary for large changes
      local change_summary
      change_summary=$(git diff --staged --name-status |
         grep -vE '\.(lock|log|tmp|cache|min\.js|min\.css|bundle\.js)$|/(dist|build|node_modules|\.git|\.cache|logs?)/' |
         awk '
                BEGIN {
                    new_count=0; mod_count=0; del_count=0; ren_count=0
                }
                /^A/ { new_files[++new_count]=$2 }
                /^M/ { mod_files[++mod_count]=$2 }
                /^D/ { del_files[++del_count]=$2 }
                /^R/ { ren_files[++ren_count]=$0 }
                END {
                    print "SUMMARY: " new_count " new, " mod_count " modified, " del_count " deleted, " ren_count " renamed files"
                    print "KEY_CHANGES:"
                    for (i=1; i<=new_count && i<=5; i++) print "  NEW: " new_files[i]
                    for (i=1; i<=mod_count && i<=5; i++) print "  MOD: " mod_files[i]
                    for (i=1; i<=del_count && i<=3; i++) print "  DEL: " del_files[i]
                    for (i=1; i<=ren_count && i<=3; i++) print "  REN: " ren_files[i]
                }
            ')

      prompt="Generate commit bullet points for this large changeset:

$change_summary

Total: $files_changed files, +$lines_added/-$lines_deleted lines

Based on the summary above, generate bullet points that:
- Summarize the main areas of change
- Highlight key new features or files added
- Note major modifications or refactoring
- Mention important deletions or renames

CRITICAL RULES - COMPLETELY IGNORE these changes:
- Whitespace, indentation, or formatting adjustments
- Empty line additions or removals
- Code style changes (spacing, line breaks, trailing whitespace)
- Comment formatting or reorganization
- Import/include statement reordering
- Variable renaming without logic changes
- Function/method reorganization without behavior changes
- Bracket or parenthesis style changes

ONLY report changes that:
- Add or remove actual functionality
- Fix bugs that change behavior
- Modify business logic or algorithms
- Change configuration that affects runtime behavior
- Add/modify/remove API endpoints or database schemas
- Improve security or performance in measurable ways
- Add or remove dependencies

IMPORTANT: Keep each bullet point under 72 characters.
Output ONLY bullet points starting with '- '. Be concise but informative.
DO NOT include semantic commit prefixes like 'feat:', 'fix:', 'docs:', 'refactor:', 'chore:', 'build:', etc.
DO NOT include scope in parentheses like '(hooks)', '(git)', '(api)', etc.
DO NOT Ask questions
Focus on WHAT functionality changed, not HOW the code looks."
   else
      local diff_names=$(git diff --staged --name-status 2>/dev/null)
      local diff_stat=$(git diff --staged --stat 2>/dev/null)

      prompt="Analyze these git changes and generate commit message bullet points.

Summary: $files_changed files changed, +$lines_added lines added, -$lines_deleted lines deleted

Files changed:
$diff_names

Diff statistics:
$diff_stat

Actual diff content (showing what was changed):
$diff_content

Based on the actual diff above, generate bullet points describing what was ACTUALLY changed.

CRITICAL: COMPLETELY IGNORE these types of changes:
- Whitespace changes (spaces, tabs, indentation)
- Empty lines added or removed
- Trailing whitespace removal
- Code formatting or style adjustments
- Comments that were just reformatted
- Import statement reordering
- Closing brace/bracket position changes
- Line wrapping or unwrapping without logic changes
- Variable/function renaming without behavior changes

ONLY report:
- Actual functionality additions or removals
- Bug fixes that change program behavior
- New features or capabilities
- Algorithm or logic modifications
- Configuration changes affecting runtime
- API changes, new endpoints, or schema changes
- Security fixes or performance improvements
- Dependency additions or removals
- Error handling improvements

Focus on WHAT the code NOW DOES differently, not formatting.

IMPORTANT: Keep each bullet point under 72 characters.
Output ONLY bullet points starting with '- '. Be specific and technical.
DO NOT include semantic commit prefixes like 'feat:', 'fix:', 'docs:', 'refactor:', 'chore:', 'build:', etc.
DO NOT include scope in parentheses like '(hooks)', '(git)', '(api)', etc.
DO NOT ask questions
Describe the functional impact, not the cosmetic changes."
   fi

   echo "$prompt"
}

# Generate AI prompt for extending existing commit message
# Only generates NEW bullet points not already covered by existing logs
generate_extend_ai_prompt() {
   local existing_logs="$1"
   local diff_content="$2"
   local files_changed="$3"
   local lines_added="$4"
   local lines_deleted="$5"

   local diff_names
   diff_names=$(git diff --staged --name-status 2>/dev/null)

   cat <<EOF
You are extending an existing commit message. Generate ONLY NEW bullet points for changes NOT already covered.

EXISTING COMMIT LOGS (do NOT repeat these):
$existing_logs

CURRENT STAGED CHANGES:
Files: $files_changed changed, +$lines_added/-$lines_deleted lines
$diff_names

DIFF:
$diff_content

INSTRUCTIONS:
- Output ONLY bullet points starting with '- ' for NEW changes
- Do NOT duplicate or rephrase any existing log points
- If all changes are already covered by existing logs, output nothing
- Keep each bullet point under 72 characters
- Focus on functional changes, not formatting
- DO NOT include semantic commit prefixes like 'feat:', 'fix:', 'docs:', etc.
- DO NOT include scope in parentheses like '(hooks)', '(git)', '(api)', etc.

OUTPUT: New bullet points only (or nothing if no new changes)
EOF
}

# -----------------------------------------------------------------------------
# AI Execution
# -----------------------------------------------------------------------------

run_ai_llm() {
   local prompt="$1"

   # Check if AI CLI is available
   if [[ ! -x "$AI_LLM_CMD" ]]; then
      log_warning "AI CLI not found at '$AI_LLM_CMD'"
      return 1
   fi

   local start_time=$(date +%s)
   log_info "🤖 Calling AI ($(basename "$AI_LLM_CMD"), model: $AI_LLM_MODEL, timeout: ${AI_MAX_TIMEOUT}s)..."

   local response
   response=$(OLLAMA_MODEL="$AI_LLM_MODEL" OPENCODE_MODEL="$AI_LLM_MODEL" timeout "$AI_MAX_TIMEOUT" "$AI_LLM_CMD" "$prompt" 2>&1)
   local exit_code=$?
   local elapsed=$(($(date +%s) - start_time))

   if [[ $exit_code -eq 0 ]]; then
      local log_points
      log_points=$(echo "$response" | grep "^- " || true)
      if [[ -n "$log_points" ]]; then
         log_success "AI generated commit points in ${elapsed}s"
         echo "$log_points"
         return 0
      fi
      log_warning "AI response didn't contain bullet points (${elapsed}s)"
   else
      log_warning "AI failed or timed out after ${elapsed}s"
   fi

   return 1
}

# -----------------------------------------------------------------------------
# JIRA Branch Interactive Mode
# -----------------------------------------------------------------------------

# Show interactive prompt for JIRA branches
prompt_commit_mode() {
   local jira_tag="$1"
   local timeout="${MAINTENANCE_TIMEOUT:-10}"

   # Check if running interactively
   if [[ ! -t 0 ]] && [[ ! -e /dev/tty ]]; then
      log_warning "Non-interactive environment detected, defaulting to AI generation"
      echo "generate"
      return
   fi

   echo "" >&2
   if is_jira_branch; then
      echo "🎫 JIRA branch detected: $jira_tag" >&2
   else
      echo "✍️  Prepare commit message" >&2
   fi
   echo "   [s]kip AI - use default template" >&2
   echo "   [l]ookup - search Commits.md for $jira_tag" >&2
   echo "   [g]enerate or Enter - run AI generation" >&2
   echo -n "Choice [s/l/g]: " >&2

   local choice
   if ! read -t "$timeout" -n 1 choice </dev/tty 2>/dev/null; then
      log_info "Timeout or TTY unavailable, defaulting to generate"
      echo "generate"
      return
   fi
   echo "" >&2

   # Flush input buffer to prevent stray characters affecting next input
   read -t 0.1 -n 10000 discard </dev/tty 2>/dev/null || true

   case "${choice,,}" in
      s) echo "skip" ;;
      l) echo "lookup" ;;
      g|"") echo "generate" ;;
      *)
         log_warning "Invalid choice '$choice', defaulting to generate"
         echo "generate"
         ;;
   esac
}

# Show prompt for extending existing commit message with AI
prompt_extend_mode() {
   local timeout="${MAINTENANCE_TIMEOUT:-10}"

   # Check if running interactively
   if [[ ! -t 0 ]] && [[ ! -e /dev/tty ]]; then
      echo "use"
      return
   fi

   echo "" >&2
   echo "📝 Staged changes detected. Extend commit message?" >&2
   echo "   [u]se existing logs as-is" >&2
   echo "   [e]xtend - AI adds new points for current changes" >&2
   echo -n "Choice [u/e]: " >&2

   local choice
   if ! read -t "$timeout" -n 1 choice </dev/tty 2>/dev/null; then
      echo "use"
      return
   fi
   echo "" >&2

   # Flush input buffer
   read -t 0.1 -n 10000 discard </dev/tty 2>/dev/null || true

   case "${choice,,}" in
      e) echo "extend" ;;
      *) echo "use" ;;
   esac
}

# -----------------------------------------------------------------------------
# Main Logic
# -----------------------------------------------------------------------------

main() {
   local commit_msg_file="$1"
   local commit_source="${2:-}"
   local sha="${3:-}"

   # Check if global hooks are enabled
   if [[ "$ENABLE_GLOBAL_HOOKS" != "true" ]]; then
      log_warning "Global git prepare-commit-msg is disabled via Git config."
      exit 0
   fi

   log_info "🚀 Global git prepare-commit-msg run"

   # Run local hooks first
   run_local_hooks "$@" || exit $?

   # Get branch information
   local branch_name
   local jira_tag

   branch_name=$(get_current_branch) || {
      log_error "Failed to get current branch name"
      exit 1
   }

   jira_tag=$(get_jira_tag) || {
      log_warning "Failed to get JIRA tag, using default"
      jira_tag="DEFAULT"
   }

   # Check if commit message is empty
   local first_line
   if [[ ! -f "$commit_msg_file" ]]; then
      log_error "Commit message file does not exist: $commit_msg_file"
      exit 1
   fi

   first_line=$(head -n1 "$commit_msg_file" 2>/dev/null) || {
      log_error "Failed to read commit message file: $commit_msg_file"
      exit 1
   }

   if [[ -z "$first_line" ]]; then
      # Always prompt — user picks skip/lookup/generate on any branch.
      # Enter/timeout => "generate"; if AI is unavailable or fails, the AI
      # block below falls back to the default template (lines ~487-492).
      local mode
      mode=$(prompt_commit_mode "$jira_tag")

      case "$mode" in
         skip)
            log_info "⏭️  Skipping AI generation"
            write_commit_message "$jira_tag" "$branch_name" "- " "$commit_msg_file" || exit 1
            exit 0
            ;;
         lookup)
            local looked_up
            if looked_up=$(lookup_commit_from_history "$jira_tag") && [[ -n "$looked_up" ]]; then
               # Validate format - must contain at least one bullet point
               if echo "$looked_up" | grep -q "^- "; then
                  log_success "📋 Found previous commit for $jira_tag"
                  echo "$looked_up" | head -5 | sed 's/^/   /' >&2

                  # Check if there are staged changes to potentially extend
                  if [[ "$ENABLE_AI_COMMIT" == "true" ]] && has_staged_changes; then
                     local extend_mode
                     extend_mode=$(prompt_extend_mode)

                     if [[ "$extend_mode" == "extend" ]]; then
                        log_info "🤔 Generating additional commit points..."

                        # Get diff info
                        local diff_stats_result
                        diff_stats_result=$(get_diff_stats) || { log_error "Failed to get diff"; exit 1; }
                        read -r files_changed lines_added lines_deleted <<<"$diff_stats_result"

                        local diff_content
                        diff_content=$(git diff --staged --unified=1 2>/dev/null | head -200)

                        # Generate extend prompt
                        local extend_prompt
                        extend_prompt=$(generate_extend_ai_prompt "$looked_up" "$diff_content" "$files_changed" "$lines_added" "$lines_deleted")

                        # Run AI
                        local new_points
                        new_points=$(run_ai_llm "$extend_prompt")

                        # Merge logs if AI produced new points
                        if [[ -n "$new_points" ]] && echo "$new_points" | grep -q "^- "; then
                           log_success "✨ Added new commit points"
                           looked_up="${looked_up}
${new_points}"
                        else
                           log_info "No additional changes to add"
                        fi
                     fi
                  fi

                  write_commit_message "$jira_tag" "$branch_name" "$looked_up" "$commit_msg_file" || exit 1
                  exit 0
               else
                  log_warning "Lookup result has invalid format, falling back to AI"
               fi
            else
               log_warning "No previous commit found, falling back to AI"
            fi
            ;;
      esac

      # Continue with AI generation
      if [[ "$ENABLE_AI_COMMIT" == "true" ]] && has_staged_changes; then
         log_info "🤔 Generating AI commit message..."

         # Get diff information
         local diff_stats_result
         diff_stats_result=$(get_diff_stats) || {
            log_error "Failed to get diff statistics"
            exit 1
         }
         read -r files_changed lines_added lines_deleted <<<"$diff_stats_result"

         local diff_content
         diff_content=$(git diff --staged --unified=1 2>/dev/null) || {
            log_error "Failed to get git diff content"
            exit 1
         }
         diff_content=$(echo "$diff_content" | head -200)

         # Generate AI prompt
         local ai_prompt=$(generate_ai_prompt "$diff_content" "$files_changed" "$lines_added" "$lines_deleted")

         # Run AI to generate commit points
         local log_points
         log_points=$(run_ai_llm "$ai_prompt")

         # Format commit message
         if [[ -n "$log_points" ]]; then
            write_commit_message "$jira_tag" "$branch_name" "$log_points" "$commit_msg_file" || exit 1
         else
            log_warning "AI generation failed, using default template"
            write_commit_message "$jira_tag" "$branch_name" "- " "$commit_msg_file" || exit 1
         fi
      else
         # No AI, use default template
         write_commit_message "$jira_tag" "$branch_name" "- " "$commit_msg_file" || exit 1
      fi
   fi
}

# Run main function
main "$@"