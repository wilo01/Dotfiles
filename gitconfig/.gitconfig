[user]
	name = wilo01
	email = wilk9496@gmail.com
[core]
	editor = nvim
	hookspath = /Users/daro/.git-template/hooks/
   pager = delta
[safe]
	directory = /Users/daro/Dotfiles.git
	directory = /Users/daro/Dotfiles.git/Linux
	directory = /Users/daro/Dotfiles.git/MacOS
[init]
	templateDir = /Users/daro/.git-template
[git-hooks]
   append-branch-name = true
   commit-on-master = false
[alias]
	stauts = status
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    dark = true
    line-numbers = true
    syntax-theme = None
    side-by-side = false
[delta "features"]
    line-numbers = true
    side-by-side = false
[delta "colors"]
    plus-line = "rgb:87ceeb"
    minus-line = "rgb:dc143c"
    plus-emph = "rgb:00ff7f"
    minus-emph = "rgb:ff4500"
    syntax = "rgb:ffffff"
    line-numbers = "rgb:737aa2"
    commit = "rgb:ffb86c"
    file-meta = "rgb:565f89"
    hunk-header = "rgb:bb9af7"
