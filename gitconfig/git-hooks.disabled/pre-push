#!/bin/bash
source "$(dirname "$(readlink -f "$0")")/branch-guard.sh" || exit 0

remote_name="$1"
refs=$(cat)

if guard_enabled Push; then
   zero_sha=$(printf '0%.0s' {1..40})
   while read -r local_ref local_sha remote_ref remote_sha; do
      [[ -z "$remote_ref" ]] && continue
      [[ "$local_sha" == "$zero_sha" ]] && continue

      if is_protected_branch "${remote_ref##*/}"; then
         refuse_push "${remote_ref##*/}" "$remote_name"
         exit 1
      fi
   done <<<"$refs"
fi

delegate_to_local_hook pre-push "$@" <<<"$refs"
