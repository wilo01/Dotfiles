#!/usr/bin/env bash
set -euo pipefail

DOMAIN="http://localhost"
PROJECT_ID="fe560626-91f2-427b-a402-8473e61943ad"
if ! curl -sf "$DOMAIN/api/status" >/dev/null 2>&1; then
    echo "ERROR: Infisical not running at $DOMAIN" >&2
    exit 1
fi

if [ -n "${1:-}" ] && [ -n "${2:-}" ]; then
    HA_URL="$1"
    HA_TOKEN="$2"
else
    echo "Usage: $0 <HOMEASSISTANT_URL> <HOMEASSISTANT_TOKEN>"
    echo "Example: $0 http://homeassistant.local:8123 eyJhbGci..."
    exit 1
fi

infisical secrets set \
    "HOMEASSISTANT_URL=$HA_URL" \
    "HOMEASSISTANT_TOKEN=$HA_TOKEN" \
    --env=dev \
    --path="/homeassistant" \
    --domain="$DOMAIN" \
    --projectId="$PROJECT_ID" \
    --silent

echo "✓ Imported Home Assistant secrets to Infisical"
echo "  Path: /homeassistant"
echo "  Secrets: HOMEASSISTANT_URL, HOMEASSISTANT_TOKEN"
