#!/usr/bin/env bash
set -euo pipefail

DOMAIN="http://localhost"
PROJECT_ID="fe560626-91f2-427b-a402-8473e61943ad"
MCP_DIR="$HOME/.Dotfiles/.Dotfiles/claude/.claude/mcp-servers"
ORACLE_ENVS=(trunk docker 121av 130av 131av 132av 81a chubbuat dss sap)

if ! curl -sf "$DOMAIN/api/status" >/dev/null 2>&1; then
    echo "ERROR: Infisical not running at $DOMAIN" >&2
    exit 1
fi

echo "Importing MCP server secrets into Infisical project: claude-mcp-servers"
echo "Project ID: $PROJECT_ID"
echo ""

for env_name in "${ORACLE_ENVS[@]}"; do
    ENV_FILE="$MCP_DIR/oracle-${env_name}.env"
    if [ ! -f "$ENV_FILE" ]; then
        echo "  SKIP oracle-$env_name (file not found)"
        continue
    fi

    ARGS=()
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" =~ ^#  ]] && continue
        ARGS+=("$key=$value")
    done < "$ENV_FILE"

    if [ ${#ARGS[@]} -gt 0 ]; then
        infisical secrets set "${ARGS[@]}" \
            --env=dev \
            --path="/oracle/$env_name" \
            --domain="$DOMAIN" \
            --projectId="$PROJECT_ID" \
            --silent
        echo "  ✓ oracle-$env_name (${#ARGS[@]} secrets)"
    fi
done

# Import JIRA
JIRA_FILE="$MCP_DIR/jira-active.env"
if [ -f "$JIRA_FILE" ]; then
    ARGS=()
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" =~ ^# ]] && continue
        ARGS+=("$key=$value")
    done < "$JIRA_FILE"

    if [ ${#ARGS[@]} -gt 0 ]; then
        infisical secrets set "${ARGS[@]}" \
            --env=dev \
            --path="/jira" \
            --domain="$DOMAIN" \
            --projectId="$PROJECT_ID" \
            --silent
        echo "  ✓ jira (${#ARGS[@]} secrets)"
    fi
fi

echo ""
echo "Import complete. Verify at $DOMAIN → claude-mcp-servers project."
echo ""
echo "Next steps:"
echo "  1. Revoke old JIRA token at https://id.atlassian.com/manage-profile/security/api-tokens"
echo "  2. Update JIRA_API_TOKEN in Infisical with the new token"
echo "  3. Run infisical-mcp-sync to generate .env files from Infisical"
