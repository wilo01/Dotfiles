#!/usr/bin/env bash
set -euo pipefail

DOMAIN="http://localhost"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! curl -sf "$DOMAIN/api/status" >/dev/null 2>&1; then
    echo "[isync] Starting Infisical stack..."
    (cd ~/.infisical && docker compose up -d 2>/dev/null)
    for i in $(seq 1 30); do
        curl -sf "$DOMAIN/api/status" >/dev/null 2>&1 && break
        sleep 1
    done
    if ! curl -sf "$DOMAIN/api/status" >/dev/null 2>&1; then
        echo "[isync] ERROR: Infisical failed to start" >&2
        exit 1
    fi
    echo "[isync] Infisical ready"
fi

echo "[isync] Syncing MCP server env files..."
"$SCRIPT_DIR/infisical-mcp-sync" --quiet

# opencode secrets are injected at runtime via `infisical run` (see the opencode
# alias in zsh/.zshrc) — no sync-to-disk step needed.

echo "[isync] $(date +%H:%M:%S) — All environments synced"
