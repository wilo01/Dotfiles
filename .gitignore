# Ignore all files and directories by default
*

# Allow specific files and directories
!~/.config/nvim/*
!~/.config/nvim-vimscript/*
!~/.config/regolith/*
!~/bin/.local/scripts/*
!~/.vim/
!/etc/regolith/i3/*
!Dotfiles.code-workspace
!settings (work copy).json
!settings.json
!README.md
!~/.gitconfig
!~/.tmux.conf
!~/.zshrc
!~/helper.py
!~/recatest/*
!sqldev/.sqldeveloper/system23*
!sqldev/.sqldeveloper/SqlHistory/*
!Browser/
!Browser/**

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
# Dependency directories
node_modules/
# Environment variables
.env
# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# OS specific
.DS_Store

# Large binary files
Browser/chrome-linux.zip
Browser/chrome-linux/

__pycache__

# OAuth credentials and sensitive files
AI-tools/.gemini/oauth_creds.json 

# Task files
# tasks.json
# tasks/ 
AI-tools/.claude.json.backup
# Claude config backups and sensitive files
AI-tools/.claude.json*
*.backup
**/oauth_creds.json
**/*api_key*
**/*API_KEY*
